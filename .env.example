# MongoDB Atlas (Atlas supports replica-set transactions required by the booking engine)
MONGODB_URI=
MONGODB_DB_NAME=gentlemens_club
SALON_ID=the-gentlemens-club-khulna
SALON_SLUG=the-gentlemens-club-khulna
SALON_NAME=The Gentlemen's Club

# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated platform-level Super Admin allowlist (higher priority than ADMIN_EMAILS)
SUPER_ADMIN_EMAILS=

# Comma-separated email allowlist for legacy salon administrators
ADMIN_EMAILS=

# Google OAuth (optional, configure for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Contact form email delivery (optional; contact API returns a setup message until configured)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bookings <bookings@example.com>
CONTACT_TO_EMAIL=

# SMS and WhatsApp (Twilio; use E.164 phone numbers, e.g. +8801XXXXXXXXX)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional approved WhatsApp Content Template SID for business-initiated messages
TWILIO_WHATSAPP_CONTENT_SID=

# Shared production rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary signed image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe refunds (only payments with providerPaymentIntentId are eligible)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bangladesh SSLCommerz refunds (payments must store bankTranId from a validated transaction)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Monitoring / alerting
ALERT_WEBHOOK_URL=
HEALTHCHECK_TOKEN=

# Seed defaults only; confirm actual opening hours with the salon
SALON_OPEN_TIME=10:00
SALON_CLOSE_TIME=20:00
